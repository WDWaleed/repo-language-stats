<svg width="495" height="{{ height }}" viewBox="0 0 495 {{ height }}" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="{{ title }}">
  <style>
{{ theme_css }}
    .card-bg { fill: var(--card-bg); stroke: var(--card-border); }
    .card-track { fill: var(--card-track); }
    .card-title { fill: var(--card-text); font-weight: 600; font-size: 15px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif; }
    .card-text { fill: var(--card-text); font-size: 12px; font-weight: 500; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif; }
    .card-secondary { fill: var(--card-secondary); font-size: 11px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif; }
  </style>
  <rect x="0.5" y="0.5" width="494" height="{{ height - 1 }}" rx="6" class="card-bg" stroke="var(--card-border)"/>
{% if not hide_title %}
  <text x="25" y="32" class="card-title">{{ title }}</text>
{% endif %}
{% if not has_stats %}
  <text x="247.5" y="{{ (height / 2) + 4 }}" class="card-secondary" text-anchor="middle" font-size="12">{{ empty_message }}</text>
{% else %}
  <clipPath id="bar-clip">
    <rect x="25" y="{{ bar_y }}" width="445" height="10" rx="5"/>
  </clipPath>
  <rect x="25" y="{{ bar_y }}" width="445" height="10" rx="5" class="card-track"/>
  <g clip-path="url(#bar-clip)">
  {% for seg in segments %}
    <rect x="{{ seg.x }}" y="{{ bar_y }}" width="{{ seg.width }}" height="10" fill="{{ seg.color }}">
      <title>{{ seg.escaped_name }}: {{ seg.percentage }}%</title>
    </rect>
  {% endfor %}
  </g>
  <g class="legend">
  {% for item in items %}
    <circle cx="{{ item.dot_x }}" cy="{{ item.dot_y }}" r="4.5" fill="{{ item.color }}"/>
    <text x="{{ item.text_x }}" y="{{ item.text_y }}" class="card-text">{{ item.escaped_name }}</text>
    <text x="{{ item.metric_x }}" y="{{ item.text_y }}" class="card-secondary">{{ item.formatted_metric }} ({{ item.percentage }}%)</text>
  {% endfor %}
  </g>
{% endif %}
</svg>
