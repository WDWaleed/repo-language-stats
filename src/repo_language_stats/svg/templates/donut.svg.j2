<svg width="495" height="220" viewBox="0 0 495 220" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="{{ title }}">
  <style>
{{ theme_css }}
    .card-bg { fill: var(--card-bg); stroke: var(--card-border); }
    .card-title { fill: var(--card-text); font-weight: 600; font-size: 15px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif; }
    .card-text { fill: var(--card-text); font-size: 12px; font-weight: 500; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif; }
    .card-secondary { fill: var(--card-secondary); font-size: 11px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif; }
    .center-metric { fill: var(--card-text); font-weight: 600; font-size: 13px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif; }
    .center-label { fill: var(--card-secondary); font-size: 10px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif; }
  </style>
  <rect x="0.5" y="0.5" width="494" height="219" rx="6" class="card-bg" stroke="var(--card-border)"/>
{% if not hide_title %}
  <text x="25" y="32" class="card-title">{{ title }}</text>
{% endif %}
{% if not has_stats %}
  <text x="247.5" y="115" class="card-secondary" text-anchor="middle" font-size="12">{{ empty_message }}</text>
{% else %}
  <g class="donut-chart">
  {% for slice in slices %}
    <path d="{{ slice.path_d }}" fill="{{ slice.color }}">
      <title>{{ slice.escaped_label }}: {{ slice.percentage }}%</title>
    </path>
  {% endfor %}
    <text x="{{ cx }}" y="{{ cy + 1 }}" class="center-metric" text-anchor="middle">{{ center_metric }}</text>
    <text x="{{ cx }}" y="{{ cy + 15 }}" class="center-label" text-anchor="middle">{{ center_label }}</text>
  </g>
  <g class="donut-legend">
  {% for item in items %}
    <circle cx="{{ item.dot_x }}" cy="{{ item.dot_y }}" r="4.5" fill="{{ item.color }}"/>
    <text x="{{ item.text_x }}" y="{{ item.text_y }}" class="card-text">{{ item.escaped_name }}</text>
    <text x="{{ item.metric_x }}" y="{{ item.text_y }}" class="card-secondary" text-anchor="end">{{ item.formatted_metric }} ({{ item.percentage }}%)</text>
  {% endfor %}
  </g>
{% endif %}
</svg>
