# Upstash Redis REST credentials (use Read-Only token for Vercel deployment)
UPSTASH_REDIS_REST_URL=https://your-database-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_read_only_token_here

# Optional: GitHub Actions workflow dispatch for on-demand refresh (M5)
GITHUB_WORKFLOW_TOKEN=your_github_pat_with_workflow_or_actions_write
GITHUB_WORKFLOW_REPO=owner/repo-name
GITHUB_WORKFLOW_ID=sync-stats.yml
GITHUB_WORKFLOW_REF=main
